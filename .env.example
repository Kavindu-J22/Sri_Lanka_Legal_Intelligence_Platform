# ==============================================================================
# SRI LANKA LEGAL INTELLIGENCE PLATFORM (SLLIP) - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file or production secrets to Git.

# --- LLM Provider (Atria ASI / OpenAI-compatible endpoint) ---
ATRIA_API_KEY=your_atria_api_key_here
ATRIA_BASE_URL=https://api.atria-asi.ai/v1
ATRIA_MODEL_ID=Atria-Dawn-Preview

# --- Vector Database Configuration ---
# Options: 'local' (ChromaDB local file), 'chroma_cloud', 'qdrant'
VECTOR_DB_BACKEND=local
VECTOR_DB_PATH=vector_db

# Optional Remote Vector DB Credentials (if using chroma_cloud or qdrant)
# CHROMA_CLOUD_API_KEY=
# CHROMA_CLOUD_TENANT=
# CHROMA_CLOUD_DATABASE=
# QDRANT_URL=
# QDRANT_API_KEY=

# --- Application Settings ---
ENVIRONMENT=development
LOG_LEVEL=INFO
