# ==============================================================================
# SLLIP V3 - STREAMLIT COMMUNITY CLOUD SECRETS TEMPLATE
# ==============================================================================
# Paste these keys directly into Streamlit Cloud -> App Settings -> Secrets

# --- LLM Provider (Atria ASI) ---
ATRIA_API_KEY = "your_atria_api_key_here"
ATRIA_BASE_URL = "https://api.atria-asi.ai/v1"
ATRIA_MODEL_ID = "Atria-Dawn-Preview"

# --- Vector Database (Qdrant Cloud) ---
VECTOR_DB_BACKEND = "qdrant"
QDRANT_URL = "https://566fc2d9-781b-4a8e-9971-50c9a94b7da6.australia-southeast1-0.gcp.cloud.qdrant.io:6333"
QDRANT_API_KEY = "your_qdrant_jwt_api_key_here"

# --- Application Settings ---
ENVIRONMENT = "production"
LOG_LEVEL = "INFO"
